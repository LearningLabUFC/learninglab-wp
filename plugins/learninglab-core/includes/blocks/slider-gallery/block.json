{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "learninglab/slider-gallery",
  "version": "1.0.0",
  "title": "Slider Gallery",
  "category": "media",
  "icon": "format-gallery",
  "description": "Carrossel de imagens interativo com suporte a upload e biblioteca de mídia.",
  "keywords": ["carrossel", "slider", "galeria", "imagens", "fotos"],
  "supports": {
    "html": false,
    "align": ["wide", "full"]
  },
  "attributes": {
    "images": {
      "type": "array",
      "default": [],
      "items": {
        "type": "object",
        "properties": {
          "id":      { "type": "number" },
          "url":     { "type": "string" },
          "alt":     { "type": "string" },
          "caption": { "type": "string" },
          "width":   { "type": "number" },
          "height":  { "type": "number" }
        }
      }
    },
    "autoplay":       { "type": "boolean", "default": true },
    "loop":           { "type": "boolean", "default": true },
    "showCaptions":   { "type": "boolean", "default": false },
    "autoplayDelay":  { "type": "number",  "default": 4000 },
    "align":          { "type": "string",  "default": "" }
  },
  "editorScript": "file:../../../build/index.js",
  "editorStyle":  "file:../../../build/index.css",
  "render":       "file:render.php",
  "textdomain":   "learninglab-core"
}
